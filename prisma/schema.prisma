generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
  // Distinct from CHARGEBACK (full): Milestone 14 policy keeps access
  // intact and requires manual review for a partial chargeback rather
  // than auto-revoking — see lib/telegram-entitlement.ts.
  PARTIAL_CHARGEBACK
}

enum TelegramAccessStatus {
  ELIGIBLE
  INVITED
  REQUESTED
  GRANTED
  REVOKED
  FAILED
  // Milestone 14 revocation lifecycle additions.
  REVOCATION_PENDING
  REVOCATION_FAILED
  MANUAL_REVIEW
}

// Outcome of the Telegram-side removal attempt during revocation —
// stored for audit, distinct from TelegramAccessStatus which tracks
// the access record's own lifecycle state.
enum TelegramRemovalOutcome {
  REMOVED
  ALREADY_NOT_MEMBER
  SKIPPED_OTHER_ENTITLEMENT
  MANUAL_REVIEW_REQUIRED
}

// Milestone 15 — generic idempotency ledger for POST endpoints that
// accept an `Idempotency-Key` header (see lib/idempotency.ts).
// `requestFingerprint` lets a replay of the same key + same payload
// return the stored response, while the same key with a different
// payload is rejected. The `@@unique([scope, key])` constraint is the
// database-level guard against a concurrent duplicate request racing
// past the application-level check.
enum IdempotencyRecordStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// Milestone 15 — append-only privacy consent ledger (see
// lib/consent.ts). Each row is one consent event (grant or revoke),
// never a single mutable boolean — the active state for a subject +
// consentType is derived by reading the most recent row.
enum ConsentStatus {
  GRANTED
  REVOKED
}

model Registration {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())

  orders          Order[]
  telegramAccount TelegramAccount?
}

model Order {
  id                     String        @id @default(cuid())
  orderNumber            String        @unique
  registrationId         String
  amount                 Int
  status                 PaymentStatus @default(PENDING)
  snapToken              String?
  snapRedirectUrl        String?
  midtransTransactionId  String?       @unique
  paymentType            String?
  paidAt                 DateTime?
  // Cumulative amount refunded so far, sourced only from Midtrans'
  // server-side transaction status (`refund_amount`) — never from the
  // browser. Used to distinguish a full refund (by value) from a
  // partial one; see lib/telegram-entitlement.ts.
  refundedAmount         Int           @default(0)
  // Milestone 15 — payment reconciliation's per-order claim (see
  // lib/payment-reconciliation.ts). Set when a worker claims a
  // PENDING order to re-check against Midtrans, cleared once that
  // check finishes (success or failure). A lock older than the
  // reconciliation job's own stale-lock window is treated as an
  // abandoned attempt and may be reclaimed.
  reconciliationLockedAt DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  webhookEvents      PaymentWebhookEvent[]
  telegramLinkTokens TelegramLinkToken[]
  telegramAccess     TelegramAccess?

  // registrationId: FK lookup/join. status: dashboards/webhook guards.
  // [status, updatedAt]: reconciliation's PENDING-order scan (see
  // lib/payment-reconciliation.ts), ordered oldest-updated-first.
  @@index([registrationId])
  @@index([status])
  @@index([status, updatedAt])
}

model PaymentWebhookEvent {
  id                String   @id @default(cuid())
  eventKey          String   @unique
  provider          String   @default("midtrans")
  orderId           String
  transactionStatus String
  payload           Json
  processedAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Menghubungkan satu Registration dengan numeric Telegram user ID
// (disimpan sebagai String agar aman untuk ID besar tanpa presisi BigInt).
model TelegramAccount {
  id             String   @id @default(cuid())
  registrationId String   @unique
  telegramUserId String   @unique
  linkedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  telegramAccesses TelegramAccess[]
}

// Token linking sekali pakai untuk /start TOKEN. Hanya hash yang disimpan,
// raw token tidak pernah ditulis ke database.
model TelegramLinkToken {
  id        String    @id @default(cuid())
  orderId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, expiresAt])
}

// Akses ke private Telegram channel untuk satu Order. `inviteLink` mentah
// disimpan sementara (perlu untuk revokeChatInviteLink) dan diperlakukan
// sebagai bearer secret: dikosongkan setelah GRANTED/REVOKED, tidak pernah
// di-log, tidak pernah diekspos lewat endpoint status umum.
// `inviteLinkHash` (SHA-256) dipakai untuk mencocokkan invite_link yang
// dikirim Telegram lewat update chat_join_request.
model TelegramAccess {
  id                String               @id @default(cuid())
  orderId           String               @unique
  telegramAccountId String
  status            TelegramAccessStatus @default(ELIGIBLE)

  inviteLink      String?
  inviteLinkHash  String?   @unique
  inviteLinkName  String?
  inviteExpiresAt DateTime?

  joinRequestedAt DateTime?
  grantedAt       DateTime?
  revokedAt       DateTime?

  lastErrorCode String?

  // Milestone 14 — revocation lifecycle. `operationVersion` backs
  // optimistic-concurrency conditional updates so only one worker can
  // claim a given revocation attempt at a time (see
  // lib/telegram-access-revocation.ts). `revocationReason` only ever
  // holds an internal code (e.g. FULL_REFUND, CHARGEBACK) — never a raw
  // Telegram/Midtrans error message or PII.
  revocationReason        String?
  revocationRequestedAt   DateTime?
  revocationStartedAt     DateTime?
  revocationAttemptCount  Int                     @default(0)
  lastRevocationAttemptAt DateTime?
  nextRevocationAttemptAt DateTime?
  lastRevocationErrorCode String?
  removalOutcome          TelegramRemovalOutcome?
  operationVersion        Int                     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  telegramAccount TelegramAccount @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)

  @@index([telegramAccountId])
  @@index([status])
  @@index([inviteExpiresAt])
  @@index([nextRevocationAttemptAt])
}

// Idempotency ledger untuk Telegram update — mencegah update yang
// dikirim ulang oleh Telegram (retry) diproses dua kali, terutama
// chat_join_request yang memicu approveChatJoinRequest.
model TelegramWebhookEvent {
  id          String    @id @default(cuid())
  updateId    String    @unique
  eventType   String
  status      String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
}

// Milestone 15 — see lib/idempotency.ts. `scope` namespaces the key
// per endpoint (e.g. "payment.create") so the same client-supplied key
// can't collide across unrelated operations.
model IdempotencyKey {
  id                 String                  @id @default(cuid())
  scope              String
  key                String
  requestFingerprint String
  status             IdempotencyRecordStatus @default(PROCESSING)
  responseStatus     Int?
  responseBody       Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  expiresAt          DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

// Milestone 15 — privacy consent ledger (see lib/consent.ts).
// `subjectType`/`subjectId` intentionally avoid a hard FK to
// Registration: consent is a compliance record that must outlive the
// subject row it describes (e.g. after a data-deletion request).
model ConsentRecord {
  id             String        @id @default(cuid())
  subjectType    String
  subjectId      String
  consentType    String
  consentVersion String
  status         ConsentStatus
  source         String
  createdAt      DateTime      @default(now())

  @@index([subjectType, subjectId, consentType, createdAt])
}

// Milestone 15 — non-PII audit trail for admin actions and scheduled
// jobs (payment reconciliation, manual admin reconciliation trigger).
// `metadata` must only ever hold small structured operational data
// (counts, status codes, order ids) — never raw payloads or PII, see
// lib/audit-log.ts.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  targetType String?
  targetId   String?
  outcome    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}
