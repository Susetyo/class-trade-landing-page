# Copy this file to .env.local and fill in real values.
# Never commit .env, .env.local, or any file with real secrets.

# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# --- Midtrans -------------------------------------------------------------
# Server-side secret key from the Midtrans dashboard. Never expose to the
# client, never log.
MIDTRANS_SERVER_KEY="changeme-midtrans-server-key"
# Client-side key, safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="changeme-midtrans-client-key"
MIDTRANS_IS_PRODUCTION="false"
# Registration price in IDR (integer, no decimals).
REGISTRATION_PRICE="150000"

# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN="changeme-telegram-bot-token"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_CHANNEL_ID="-1000000000000"
TELEGRAM_CHANNEL_INVITE_TTL_MINUTES="30"
# Random secret Telegram sends back in X-Telegram-Bot-Api-Secret-Token
# on every webhook call — see docs/security-reliability.md for how to
# generate and register it. Minimum 16 characters.
TELEGRAM_WEBHOOK_SECRET="changeme-generate-a-long-random-secret"
# Stable HTTPS production URL (no trailing slash), used to build the
# Telegram webhook URL and deep links. Not a preview deployment URL.
APP_URL="https://your-production-domain.example"

# --- Admin (Milestone 15) -------------------------------------------------
# Bearer secret for admin-only endpoints (e.g. POST /api/admin/reconciliation).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters. Required in production — the app fails to start
# without it (see lib/env.ts assertRequiredSecurityEnv).
ADMIN_API_SECRET="changeme-generate-a-long-random-secret-min-32-chars"

# --- Outbound HTTP (Midtrans/Telegram API calls) — Milestone 15 ----------
OUTBOUND_REQUEST_TIMEOUT_MS="10000"
OUTBOUND_MAX_RETRIES="2"
OUTBOUND_RETRY_BASE_DELAY_MS="300"

# --- Rate limiting (Milestone 15) -----------------------------------------
# Set to "false" to disable rate limiting entirely (e.g. local dev).
RATE_LIMIT_ENABLED="true"

# --- Payment reconciliation (Milestone 15) --------------------------------
RECONCILIATION_PENDING_AGE_MINUTES="30"
RECONCILIATION_BATCH_SIZE="50"
RECONCILIATION_CONCURRENCY="5"
# Cron expression documentation only — see docs/security-reliability.md
# for how to wire this into your scheduler of choice.
RECONCILIATION_CRON="*/15 * * * *"

# --- Error monitoring (Milestone 15) --------------------------------------
# Leave ERROR_MONITORING_ENABLED unset/false for local/test — this is a
# no-op by default. See lib/error-monitoring.ts.
ERROR_MONITORING_ENABLED="false"
ERROR_MONITORING_DSN=""
